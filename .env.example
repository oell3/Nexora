# ---------------------------------------------------------------------------
# Nexora - Konfiguration fuer "docker compose"
#
# Verwendung:  cp .env.example .env   (Windows: Copy-Item .env.example .env)
# Die .env wird nicht versioniert und enthaelt Zugangsdaten.
#
#
# Alle Werte werden als Umgebungsvariablen an den Container uebergeben und
# ueberschreiben die entsprechenden Werte aus appsettings.json.
# ---------------------------------------------------------------------------
# Port, unter dem die API am Docker-Host erreichbar ist (linke Seite des
# Portmappings). Muss auf dem Host frei sein - bei "port is already allocated"
# hier einen anderen Port eintragen. Belegte Ports anzeigen:
#   docker ps --format "{{.Names}}\t{{.Ports}}"
# Default 18089 statt 8089, weil 8080/8089 auf Servern mit mehreren Diensten
# haeufig schon vergeben sind.
API_HOST_PORT=18089

# Listenport der API IM CONTAINER (Kestrel bindet auf Server:Port / Server__Port).
SERVER_PORT=8089

# Origins, die das Frontend benutzen darf (Cors:AllowedOrigins), mehrere mit ";"
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Datenbank -------------------------------------------------------------
# Es wird der bereits laufende Postgres-Container genutzt (kein zweiter Stack).
# DB_HOST    = Name des Containers im Docker-Netzwerk, hier "postgresql".
# Der API-Container wird automatisch mit den externen Netzwerken
# "postgresql_default" und "crm-network" verbunden.
DB_HOST=postgresql
# Port IM Postgres-Container (nicht der Port am Docker-Host).
DB_PORT=5432
# Zugangsdaten der vorhandenen Datenbank (siehe appsettings.json).
DB_USER=trix0
DB_PASSWORD=hier-das-passwort-des-vorhandenen-postgres-eintragen
DB_NAME=angebotstool
# Nur fuer den auskommentierten eigenen db-Service in docker-compose.yml:
# DB_EXPOSED_PORT=5433

# --- JWT -------------------------------------------------------------------
# JWT_SECRET muss mindestens 32 Zeichen lang sein (HMAC-SHA256).
JWT_ISSUER=Nexora
JWT_AUDIENCE=Nexora
JWT_SECRET=hier-einen-zufaelligen-schluessel-mit-mindestens-32-zeichen-eintragen

# --- Sonstiges -------------------------------------------------------------
TZ=Europe/Berlin
